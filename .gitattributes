# ── line endings ────────────────────────────────────────────────────────
# Everything the browser parses is stored and checked out with LF, on every
# machine. Without this, a fresh Windows clone defaults to core.autocrlf=true
# and the whole CSS/JS tree shows up as modified on first open.
* text=auto eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.svg  text eol=lf

# ── binary, never diffed as text ────────────────────────────────────────
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.ico   binary
*.woff2 binary
*.woff  binary
*.ttf   binary
*.zip   binary

# ── keep the repo's language stats honest ───────────────────────────────
shots/*        linguist-vendored
assets/img/**  linguist-vendored
assets/fonts/** linguist-vendored
