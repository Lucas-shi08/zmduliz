#!/bin/sh
# 提交前看一眼颜色和字体有没有被动过。
# 只是提醒，永远不会拦你的提交。
#
# 安装（每台克隆一次）：git config core.hooksPath .githooks
# 不想看这套提示：  SKIP_DESIGN_GUARD=1 git commit ...

[ "$SKIP_DESIGN_GUARD" = "1" ] && exit 0

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  exit 0
fi

out=$("$PY" tools/guard_design.py check 2>&1)
code=$?

if [ "$code" -ne 0 ]; then
  printf '\n%s\n\n' "$out"
  printf '(只是提醒，提交照常继续)\n\n'
fi

exit 0
